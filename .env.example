# TMS 面板 Compose 配置模板
# 复制为 .env 后修改所有 CHANGE_ME 项，再执行 docker compose pull && docker compose up -d

DB_NAME=gost
DB_USER=gost
DB_PASSWORD=CHANGE_ME_use_a_long_random_password
JWT_SECRET=CHANGE_ME_use_a_long_random_string

# 浏览器访问面板的端口
FRONTEND_PORT=6366
# 节点连接面板后端的公网端口
BACKEND_PORT=6365

# 仅 docker-compose-v6.yml 使用；Docker IPv6 网络通常需要显式私有网段
# TMS_IPV6_SUBNET=fd00:dead:beef::/48
